<Window
    x:Class="Detent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="Detent">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Detent" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="CurrentSpeedText"
                Opacity="0.7"
                Text="系统指针速度" />
        </StackPanel>
        <ListView
            x:Name="LevelList"
            Grid.Row="1"
            SelectionChanged="LevelList_SelectionChanged" />
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="Detent"
            LeftClickCommand="{x:Bind ShowWindowCommand}" />
    </Grid>
</Window>
